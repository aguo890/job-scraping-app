# Environment Variables Template
# Copy this file to .env and fill in your values

# GitHub Configuration (Mandatory for Automated Backups)
# GITHUB_TOKEN=your_github_personal_access_token (Requires 'repo' scope)
# GITHUB_REPOSITORY=username/repo-name

# OpenAI API Key (optional - for AI features)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Filtering Strategy
# MAX_YOE=2 (Maximum years of experience allowed)
# STRICT_MODE=true (Hard-drop any job with a negative total score)

# Note: In GitHub Actions, these are automatically configured as secrets
# and don't need to be set in .env
